@model Application.Features.FastFood.Dtos.SubscriptionCustomerUpsertDto
@{
    Layout = "_AdminLayout"; ViewData["Title"] = "افزودن مشترک";
}

<section class="content-header">
    <div class="container-fluid">
        <h1 class="m-0">@ViewData["Title"]</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        @await Html.PartialAsync("_Alerts")

        <div class="card">
            <div class="card-body">
                <form asp-area="Admin" asp-controller="SubscriptionCustomers" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-4 form-group">
                            <label asp-for="FirstName">نام</label>
                            <input class="form-control" asp-for="FirstName" />
                        </div>
                        <div class="col-md-4 form-group">
                            <label asp-for="LastName">نام خانوادگی</label>
                            <input class="form-control" asp-for="LastName" />
                        </div>
                        <div class="col-md-4 form-group d-flex align-items-end">
                            <div class="alert alert-info mb-0 w-100">شناسه اشتراک به‌صورت خودکار ثبت می‌شود.</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 form-group">
                            <label asp-for="Mobile">موبایل</label>
                            <input class="form-control" asp-for="Mobile" />
                        </div>
                        <div class="col-md-4 form-group">
                            <label asp-for="Phone">تلفن</label>
                            <input class="form-control" asp-for="Phone" />
                        </div>
                        <div class="col-md-4 form-group">
                            <label asp-for="IsActive">فعال</label>
                            <select class="form-control" asp-for="IsActive">
                                <option value="true">بله</option>
                                <option value="false">خیر</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Address">آدرس</label>
                        <textarea class="form-control" rows="3" asp-for="Address"></textarea>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description">توضیحات</label>
                        <textarea class="form-control" rows="4" asp-for="Description"></textarea>
                    </div>

                    <button class="btn btn-success" type="submit">
                        <i class="fas fa-save ml-1"></i> ذخیره
                    </button>
                    <a class="btn btn-secondary" asp-area="Admin" asp-controller="SubscriptionCustomers" asp-action="Index">بازگشت</a>
                </form>
            </div>
        </div>
    </div>
</section>
