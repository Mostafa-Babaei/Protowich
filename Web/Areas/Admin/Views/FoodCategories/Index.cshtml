@model Web.Areas.Admin.Models.FoodCategoryIndexVm
@{
    Layout = "_AdminLayout"; ViewData["Title"] = "دسته‌بندی غذا";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center">
            <h1 class="m-0">دسته‌بندی‌های منو</h1>
            <a class="btn btn-primary" asp-area="Admin" asp-controller="FoodCategories" asp-action="Create">
                <i class="fas fa-plus ml-1"></i> افزودن
            </a>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        @await Html.PartialAsync("_Alerts")

        <div class="card">
            <div class="card-header">
                <form method="get" class="row">
                    <div class="col-md-4">
                        <input class="form-control" name="Keyword" value="@Model.Keyword" placeholder="جستجو (عنوان/توضیح)">
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-secondary w-100" type="submit">
                            <i class="fas fa-search ml-1"></i> جستجو
                        </button>
                    </div>
                </form>
            </div>

            <div class="card-body table-responsive p-0">
                <table class="table table-hover text-nowrap mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>عنوان</th>
                            <th>ترتیب</th>
                            <th>فعال</th>
                            <th>تعداد آیتم</th>
                            <th style="width:320px;">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Data?.Items == null || !Model.Data.Items.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted p-4">موردی یافت نشد</td></tr>
                        }
                        else
                        {
                            foreach (var x in Model.Data.Items)
                            {
                                <tr>
                                    <td>@x.Id</td>
                                    <td>@x.Title</td>
                                    <td>@x.DisplayOrder</td>
                                    <td>
                                        @if (x.IsActive)
                                        {
                                            <span class="badge badge-success">فعال</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">غیرفعال</span>
                                        }
                                    </td>
                                    <td>@x.ItemsCount</td>
                                    <td>
                                        <a class="btn btn-sm btn-info" asp-area="Admin" asp-controller="FoodCategories" asp-action="Edit" asp-route-id="@x.Id">
                                            <i class="fas fa-edit ml-1"></i> ویرایش
                                        </a>
                                        <form asp-area="Admin" asp-controller="FoodCategories" asp-action="SetActive" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@x.Id" />
                                            <input type="hidden" name="isActive" value="@(x.IsActive ? "false" : "true")" />
                                            <button type="submit" class="btn btn-sm @(x.IsActive ? "btn-warning" : "btn-success")">
                                                <i class="fas @(x.IsActive ? "fa-ban" : "fa-check") ml-1"></i>
                                                @(x.IsActive ? "غیرفعال" : "فعال")
                                            </button>
                                        </form>
                                        <button type="button"
                                                class="btn btn-sm btn-secondary js-show-category-items"
                                                data-category-id="@x.Id"
                                                data-category-title="@x.Title">
                                            <i class="fas fa-list ml-1"></i> آیتم‌ها
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-primary js-open-bulk-add-items"
                                                data-category-id="@x.Id"
                                                data-category-title="@x.Title">
                                            <i class="fas fa-layer-group ml-1"></i> افزودن گروهی
                                        </button>
                                        <a class="btn btn-sm btn-danger" asp-area="Admin" asp-controller="FoodCategories" asp-action="Delete" asp-route-id="@x.Id">
                                            <i class="fas fa-trash ml-1"></i> حذف
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer">
                @* Pagination ساده *@
                @{
                    var page = Model.Data?.Page ?? 1;
                    var pageSize = Model.Data?.PageSize ?? 20;
                    var total = Model.Data?.TotalCount ?? 0;
                    var totalPages = (int)Math.Ceiling(total / (double)pageSize);
                }
                <div class="d-flex justify-content-between align-items-center">
                    <div class="text-muted">کل: @total</div>
                    <div>
                        @for (int p = 1; p <= Math.Max(1, totalPages); p++)
                        {
                            <a class="btn btn-sm @(p==page ? "btn-primary" : "btn-outline-primary")"
                               href="@Url.Action("Index", new { Page=p, PageSize=pageSize, Keyword=Model.Keyword })">@p</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@Html.AntiForgeryToken()

<div class="modal fade" id="categoryItemsModal" tabindex="-1" role="dialog" aria-labelledby="categoryItemsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="categoryItemsModalLabel">آیتم‌های دسته‌بندی</h5>
                <button type="button" class="close ml-0 mr-auto" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="categoryItemsModalBody" class="p-1">
                    <div class="text-muted">در حال بارگذاری...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bulkAddItemsModal" tabindex="-1" role="dialog" aria-labelledby="bulkAddItemsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bulkAddItemsModalLabel">افزودن گروهی آیتم‌ها</h5>
                <button type="button" class="close ml-0 mr-auto" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <small class="text-muted">برای هر ردیف نام و قیمت را وارد کنید.</small>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="btn-add-bulk-row">
                        <i class="fas fa-plus ml-1"></i> ردیف جدید
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-0">
                        <thead>
                            <tr>
                                <th style="width:60px;">#</th>
                                <th>نام آیتم</th>
                                <th style="width:220px;">قیمت (تومان)</th>
                                <th style="width:100px;">حذف</th>
                            </tr>
                        </thead>
                        <tbody id="bulk-items-tbody"></tbody>
                    </table>
                </div>
                <div id="bulkAddItemsMessage" class="small mt-2"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">بستن</button>
                <button type="button" class="btn btn-success" id="btn-save-bulk-items">
                    <i class="fas fa-save ml-1"></i> ذخیره همه
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const endpointBase = '@Url.Action("GetCategoryItems", "FoodCategories", new { area = "Admin" })';
            const updatePricesBulkEndpoint = '@Url.Action("UpdateCategoryItemsPrices", "FoodCategories", new { area = "Admin" })';
            const toggleAvailabilityEndpoint = '@Url.Action("ToggleCategoryItemAvailability", "FoodCategories", new { area = "Admin" })';
            const updateOrderEndpoint = '@Url.Action("UpdateCategoryItemsOrder", "FoodCategories", new { area = "Admin" })';
            const addBulkItemsEndpoint = '@Url.Action("AddCategoryItemsBulk", "FoodCategories", new { area = "Admin" })';
            const modal = $('#categoryItemsModal');
            const modalTitle = $('#categoryItemsModalLabel');
            const modalBody = $('#categoryItemsModalBody');
            const bulkModal = $('#bulkAddItemsModal');
            const bulkModalTitle = $('#bulkAddItemsModalLabel');
            const bulkTbody = $('#bulk-items-tbody');
            const bulkMessage = $('#bulkAddItemsMessage');
            const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            let currentCategoryId = 0;
            let currentBulkCategoryId = 0;
            let draggedRow = null;

            function escapeHtml(input) {
                return String(input ?? '')
                    .split('&').join('&amp;')
                    .split('<').join('&lt;')
                    .split('>').join('&gt;')
                    .split('"').join('&quot;')
                    .split("'").join('&#39;');
            }

            function formatPrice(value) {
                const number = Number(value ?? 0);
                return number.toLocaleString('fa-IR');
            }

            function renderItems(items) {
                if (!items || items.length === 0) {
                    modalBody.html('<div class="text-muted">برای این دسته‌بندی آیتمی ثبت نشده است.</div>');
                    return;
                }

                let html = '<div class="d-flex justify-content-between align-items-center mb-2">';
                html += '<small class="text-muted">قیمت‌ها را ویرایش کنید و با یک دکمه همه را ذخیره کنید.</small>';
                html += '<div>';
                html += '<button type="button" id="btn-save-all-prices" class="btn btn-sm btn-success ml-1">ذخیره همه قیمت‌ها</button>';
                html += '<button type="button" id="btn-save-items-order" class="btn btn-sm btn-primary">ذخیره ترتیب</button>';
                html += '</div>';
                html += '</div>';

                html += '<div class="table-responsive"><table class="table table-sm table-bordered mb-0">';
                html += '<thead><tr><th style="width:54px;">ترتیب</th><th style="width:70px;">#</th><th>عنوان</th><th style="width:210px;">قیمت</th><th style="width:130px;">وضعیت</th><th style="width:150px;">عملیات</th></tr></thead><tbody id="category-items-tbody">';

                for (const item of items) {
                    const statusBadge = item.isAvailable
                        ? '<span class="badge badge-success">موجود</span>'
                        : '<span class="badge badge-secondary">ناموجود</span>';

                    html += '<tr>';
                    html += `<td class="text-center align-middle" title="Drag & Drop" style="cursor:grab;" draggable="true"><i class="fas fa-grip-vertical text-muted"></i></td>`;
                    html += `<td class="align-middle" data-item-id="${item.id}">${item.id}</td>`;
                    html += `<td>${escapeHtml(item.title)}</td>`;
                    html += '<td>';
                    html += `<div class="input-group input-group-sm">`;
                    html += `<input type="number" min="0" step="1000" class="form-control js-price-input" value="${item.price}" data-item-id="${item.id}" data-original-price="${item.price}" />`;
                    html += `<div class="input-group-append"><span class="input-group-text">تومان</span></div>`;
                    html += `</div>`;
                    html += '</td>';
                    html += `<td class="align-middle"><span class="js-status-badge" data-item-id="${item.id}">${statusBadge}</span></td>`;
                    html += '<td class="align-middle">';
                    html += `<button type="button" class="btn btn-sm ${item.isAvailable ? 'btn-warning' : 'btn-success'} js-toggle-availability" data-item-id="${item.id}" data-is-available="${item.isAvailable ? 'true' : 'false'}">${item.isAvailable ? 'غیرفعال' : 'فعال'}</button>`;
                    html += '</td>';
                    html += '</tr>';
                }

                html += '</tbody></table></div>';
                modalBody.html(html);
                wireRowDragAndDrop();
            }

            function addBulkRow(title, price) {
                const index = bulkTbody.find('tr').length + 1;
                const safeTitle = escapeHtml(title || '');
                const safePrice = Number.isFinite(Number(price)) ? String(price) : '';

                const rowHtml = `
                    <tr>
                        <td class="align-middle text-center js-row-index">${index}</td>
                        <td><input type="text" class="form-control form-control-sm js-bulk-title" value="${safeTitle}" placeholder="مثال: ساندویچ مرغ" /></td>
                        <td><input type="number" min="0" step="1000" class="form-control form-control-sm js-bulk-price" value="${safePrice}" placeholder="مثال: 180000" /></td>
                        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger js-remove-bulk-row"><i class="fas fa-times"></i></button></td>
                    </tr>`;
                bulkTbody.append(rowHtml);
            }

            function refreshBulkRowIndexes() {
                bulkTbody.find('.js-row-index').each(function (i) {
                    $(this).text(i + 1);
                });
            }

            function resetBulkModalRows() {
                bulkTbody.empty();
                addBulkRow('', '');
                addBulkRow('', '');
                addBulkRow('', '');
                bulkMessage.removeClass('text-danger text-success').text('');
            }

            function getOrderedIds() {
                return $('#category-items-tbody tr')
                    .map(function () { return $(this).find('[data-item-id]').data('item-id'); })
                    .get()
                    .filter(x => !!x);
            }

            function wireRowDragAndDrop() {
                const tbody = document.getElementById('category-items-tbody');
                if (!tbody) return;

                tbody.querySelectorAll('tr').forEach(row => {
                    row.draggable = true;

                    row.addEventListener('dragstart', function () {
                        draggedRow = row;
                        row.style.opacity = '0.5';
                    });

                    row.addEventListener('dragend', function () {
                        row.style.opacity = '1';
                        draggedRow = null;
                    });

                    row.addEventListener('dragover', function (e) {
                        e.preventDefault();
                    });

                    row.addEventListener('drop', function (e) {
                        e.preventDefault();
                        if (!draggedRow || draggedRow === row) return;

                        const rect = row.getBoundingClientRect();
                        const dropBelow = (e.clientY - rect.top) > (rect.height / 2);

                        if (dropBelow) {
                            row.after(draggedRow);
                        } else {
                            row.before(draggedRow);
                        }
                    });
                });
            }

            async function postForm(url, data) {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: new URLSearchParams(data)
                });

                if (!response.ok) {
                    return { isSuccess: false, message: 'خطا در ارتباط با سرور.' };
                }

                return response.json();
            }

            $(document).on('click', '.js-show-category-items', async function () {
                const categoryId = $(this).data('category-id');
                const categoryTitle = $(this).data('category-title');
                currentCategoryId = Number(categoryId || 0);

                modalTitle.text(`آیتم‌های دسته‌بندی: ${categoryTitle}`);
                modalBody.html('<div class="text-muted">در حال بارگذاری...</div>');
                modal.modal('show');

                try {
                    const response = await fetch(`${endpointBase}?id=${encodeURIComponent(categoryId)}`, {
                        method: 'GET',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (!response.ok) {
                        modalBody.html('<div class="text-danger">خطا در دریافت اطلاعات.</div>');
                        return;
                    }

                    const payload = await response.json();
                    if (!payload.isSuccess) {
                        const message = payload.message || 'خطا در دریافت اطلاعات.';
                        modalBody.html(`<div class="text-danger">${escapeHtml(message)}</div>`);
                        return;
                    }

                    renderItems(payload.items);
                } catch {
                    modalBody.html('<div class="text-danger">خطا در ارتباط با سرور.</div>');
                }
            });

            $(document).on('click', '.js-open-bulk-add-items', function () {
                const categoryId = Number($(this).data('category-id') || 0);
                const categoryTitle = $(this).data('category-title') || '';
                currentBulkCategoryId = categoryId;

                bulkModalTitle.text(`افزودن گروهی آیتم‌ها: ${categoryTitle}`);
                resetBulkModalRows();
                bulkModal.modal('show');
            });

            $(document).on('click', '#btn-add-bulk-row', function () {
                addBulkRow('', '');
                refreshBulkRowIndexes();
            });

            $(document).on('click', '.js-remove-bulk-row', function () {
                $(this).closest('tr').remove();
                if (bulkTbody.find('tr').length === 0) {
                    addBulkRow('', '');
                }
                refreshBulkRowIndexes();
            });

            $(document).on('click', '#btn-save-bulk-items', async function () {
                if (currentBulkCategoryId <= 0) {
                    bulkMessage.removeClass('text-success').addClass('text-danger').text('دسته‌بندی نامعتبر است.');
                    return;
                }

                const items = [];
                let hasInvalid = false;

                bulkTbody.find('tr').each(function () {
                    const title = String($(this).find('.js-bulk-title').val() || '').trim();
                    const priceText = String($(this).find('.js-bulk-price').val() || '').trim();

                    if (!title && !priceText) return;

                    const price = Number(priceText);
                    if (!title || Number.isNaN(price) || price < 0) {
                        hasInvalid = true;
                        return false;
                    }

                    items.push({ title: title, price: price });
                });

                if (hasInvalid) {
                    bulkMessage.removeClass('text-success').addClass('text-danger').text('حداقل یک ردیف نامعتبر است. نام و قیمت معتبر وارد کنید.');
                    return;
                }

                if (!items.length) {
                    bulkMessage.removeClass('text-success').addClass('text-danger').text('حداقل یک آیتم برای ثبت وارد کنید.');
                    return;
                }

                const payload = await postForm(addBulkItemsEndpoint, {
                    categoryId: String(currentBulkCategoryId),
                    itemsJson: JSON.stringify(items),
                    __RequestVerificationToken: antiForgeryToken
                });

                if (!payload.isSuccess) {
                    bulkMessage.removeClass('text-success').addClass('text-danger').text(payload.message || 'خطا در ثبت گروهی آیتم‌ها.');
                    return;
                }

                bulkMessage.removeClass('text-danger').addClass('text-success').text(payload.message || 'ثبت گروهی با موفقیت انجام شد.');
                setTimeout(function () {
                    bulkModal.modal('hide');
                    location.reload();
                }, 600);
            });

            $(document).on('click', '#btn-save-all-prices', async function () {
                if (currentCategoryId <= 0) {
                    alert('دسته‌بندی نامعتبر است.');
                    return;
                }

                const pairs = [];
                let hasInvalid = false;

                $('.js-price-input').each(function () {
                    const input = $(this);
                    const itemId = Number(input.data('item-id') || 0);
                    const price = Number(input.val());

                    if (itemId <= 0 || Number.isNaN(price) || price < 0) {
                        hasInvalid = true;
                        return false;
                    }

                    pairs.push(`${itemId}:${price}`);
                });

                if (hasInvalid) {
                    alert('حداقل یک قیمت نامعتبر است.');
                    return;
                }

                if (!pairs.length) {
                    alert('آیتمی برای ذخیره وجود ندارد.');
                    return;
                }

                const payload = await postForm(updatePricesBulkEndpoint, {
                    categoryId: String(currentCategoryId),
                    items: pairs.join(';'),
                    __RequestVerificationToken: antiForgeryToken
                });

                if (!payload.isSuccess) {
                    alert(payload.message || 'خطا در ذخیره گروهی قیمت‌ها.');
                    return;
                }

                $('.js-price-input').each(function () {
                    const input = $(this);
                    input.attr('data-original-price', String(input.val()));
                });
            });

            $(document).on('click', '.js-toggle-availability', async function () {
                const button = $(this);
                const itemId = Number(button.data('item-id') || 0);
                const current = String(button.data('is-available')) === 'true';
                const next = !current;

                const payload = await postForm(toggleAvailabilityEndpoint, {
                    id: String(itemId),
                    isAvailable: String(next),
                    __RequestVerificationToken: antiForgeryToken
                });

                if (!payload.isSuccess) {
                    alert(payload.message || 'خطا در تغییر وضعیت.');
                    return;
                }

                button.data('is-available', String(next));
                button
                    .toggleClass('btn-success', !next)
                    .toggleClass('btn-warning', next)
                    .text(next ? 'غیرفعال' : 'فعال');

                const badge = $(`.js-status-badge[data-item-id="${itemId}"]`);
                badge.html(next
                    ? '<span class="badge badge-success">موجود</span>'
                    : '<span class="badge badge-secondary">ناموجود</span>');
            });

            $(document).on('click', '#btn-save-items-order', async function () {
                if (currentCategoryId <= 0) {
                    alert('دسته‌بندی نامعتبر است.');
                    return;
                }

                const orderedIds = getOrderedIds();
                if (!orderedIds.length) {
                    alert('لیست آیتم‌ها خالی است.');
                    return;
                }

                const payload = await postForm(updateOrderEndpoint, {
                    categoryId: String(currentCategoryId),
                    orderedIds: orderedIds.join(','),
                    __RequestVerificationToken: antiForgeryToken
                });

                if (!payload.isSuccess) {
                    alert(payload.message || 'خطا در ذخیره ترتیب.');
                    return;
                }
            });
        })();
    </script>
}
