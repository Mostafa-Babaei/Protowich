@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "داشبورد ادمین";
}

<section class="content-header">
    <div class="container-fluid">
        <h1 class="m-0">@ViewData["Title"]</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-4">
                <div class="small-box bg-primary">
                    <div class="inner">
                        <h4>مدیریت منو</h4>
                        <p>دسته بندی ها و آیتم ها</p>
                    </div>
                    <div class="icon"><i class="fas fa-utensils"></i></div>
                    <a asp-area="Admin" asp-controller="ManageMenu" asp-action="Index" class="small-box-footer">
                        ورود <i class="fas fa-arrow-circle-left"></i>
                    </a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h4>دسته بندی ها</h4>
                        <p>مدیریت دسته بندی غذا</p>
                    </div>
                    <div class="icon"><i class="fas fa-folder"></i></div>
                    <a asp-area="Admin" asp-controller="FoodCategories" asp-action="Index" class="small-box-footer">
                        ورود <i class="fas fa-arrow-circle-left"></i>
                    </a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h4>آیتم های منو</h4>
                        <p>مدیریت غذا و قیمت</p>
                    </div>
                    <div class="icon"><i class="fas fa-list"></i></div>
                    <a asp-area="Admin" asp-controller="FoodItems" asp-action="Index" class="small-box-footer">
                        ورود <i class="fas fa-arrow-circle-left"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
