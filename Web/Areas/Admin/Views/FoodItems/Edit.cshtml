@model Web.Areas.Admin.Models.FoodItemFormVm
@{
    Layout = "_AdminLayout"; ViewData["Title"] = "ویرایش آیتم";
}

<section class="content">
    <div class="container-fluid">
        @await Html.PartialAsync("_Alerts")

        <div class="row">
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">ویرایش آیتم</h3></div>
                    <div class="card-body">
                        <form method="post">
                            @Html.AntiForgeryToken()

                            <div class="form-group">
                                <label>دسته‌بندی</label>
                                <select class="form-control" asp-for="Dto.FoodCategoryId">
                                    @foreach (var c in Model.Categories)
                                    {
                                        <option value="@c.Id" selected="@(Model.Dto.FoodCategoryId == c.Id)">@c.Title</option>
                                    }
                                </select>
                            </div>

                            <div class="form-group">
                                <label>عنوان</label>
                                <input class="form-control" asp-for="Dto.Title" />
                            </div>

                            <div class="form-group">
                                <label>توضیح</label>
                                <textarea class="form-control" rows="3" asp-for="Dto.Description"></textarea>
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>قیمت</label>
                                        <input class="form-control" type="number" step="0.01" asp-for="Dto.Price" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>ترتیب</label>
                                        <input class="form-control" type="number" asp-for="Dto.DisplayOrder" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>موجود</label>
                                        <select class="form-control" asp-for="Dto.IsAvailable">
                                            <option value="true">بله</option>
                                            <option value="false">خیر</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <button class="btn btn-success" type="submit"><i class="fas fa-save ml-1"></i> ذخیره</button>
                            <a class="btn btn-secondary" asp-area="Admin" asp-controller="FoodItems" asp-action="Index">بازگشت</a>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3 class="card-title m-0">تصاویر</h3>
                        <a class="btn btn-sm btn-primary"
                           asp-area="Admin" asp-controller="FoodImages" asp-action="Create"
                           asp-route-foodItemId="@Model.Id">
                            <i class="fas fa-plus ml-1"></i> افزودن تصویر
                        </a>
                    </div>

                    <div class="card-body">
                        @if (Model.Images == null || Model.Images.Count == 0)
                        {
                            <div class="text-muted">تصویری ثبت نشده است.</div>
                        }
                        else
                        {
                            foreach (var img in Model.Images)
                            {
                                <div class="d-flex align-items-center mb-2" style="gap:10px;">
                                    <img src="@img.ImageUrl" style="width:70px;height:70px;object-fit:cover;border-radius:10px;" />
                                    <div class="flex-grow-1">
                                        @if (img.IsMain)
                                        {
                                            <span class="badge badge-success">اصلی</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">—</span>
                                        }
                                        <div class="small text-muted">Order: @img.DisplayOrder</div>
                                    </div>

                                    <div class="d-flex" style="gap:6px;">
                                        @if (!img.IsMain)
                                        {
                                            <form method="post" asp-area="Admin" asp-controller="FoodImages" asp-action="SetMain" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="imageId" value="@img.Id" />
                                                <input type="hidden" name="foodItemId" value="@Model.Id" />
                                                <button class="btn btn-sm btn-outline-success" type="submit">اصلی</button>
                                            </form>
                                        }

                                        <a class="btn btn-sm btn-outline-danger"
                                           asp-area="Admin" asp-controller="FoodImages" asp-action="Delete"
                                           asp-route-id="@img.Id" asp-route-foodItemId="@Model.Id">
                                            حذف
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
