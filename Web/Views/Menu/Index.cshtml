@model Web.Models.PublicMenuPageVm
@{
    ViewData["Title"] = "منو";

    var activeTheme = (Model.ActiveThemeKey ?? "classic").Trim().ToLowerInvariant();
    var partialName = activeTheme == "modern1"
        ? "_MenuThemeModern1"
        : "_MenuThemeClassic";
}

@await Html.PartialAsync(partialName, Model)
