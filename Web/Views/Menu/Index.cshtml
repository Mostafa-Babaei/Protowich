
@model IReadOnlyList<Application.Features.FastFood.Dtos.PublicMenuCategoryDto>
@{
    ViewData["Title"] = "منو";
}

<div class="container-fluid py-3 menu-page">
    <div class="row mb-3">
        <div class="col-12">
            <h1 class="h3 mb-2">منوی رستوران</h1>
            <p class="text-muted mb-0">دسته‌بندی‌ها و آیتم‌های موجود</p>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning mb-4">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">فعلا آیتمی برای نمایش وجود ندارد.</div>
    }
    else
    {
        @foreach (var category in Model.OrderBy(c => c.DisplayOrder))
        {
            <section class="card card-outline card-primary mb-4">
                <div class="card-header">
                    <h2 class="card-title m-0">@category.Title</h2>
                </div>

                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(category.Description))
                    {
                        <p class="text-muted mb-4">@category.Description</p>
                    }

                    @if (category.Items == null || category.Items.Count == 0)
                    {
                        <div class="text-muted">در این دسته‌بندی آیتمی ثبت نشده است.</div>
                    }
                    else
                    {
                        <div class="row">
                            @foreach (var item in category.Items.OrderBy(i => i.DisplayOrder))
                            {
                                <div class="col-12 col-md-6 col-xl-4 mb-3">
                                    <article class="menu-item card h-100 shadow-sm">
                                        @if (!string.IsNullOrWhiteSpace(item.MainImageUrl))
                                        {
                                            <img src="@item.MainImageUrl" class="card-img-top menu-item-image" alt="@item.Title" />
                                        }

                                        <div class="card-body d-flex flex-column">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h3 class="h6 mb-0">@item.Title</h3>
                                                <span class="badge badge-success menu-price">@item.Price.ToString("N0") تومان</span>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(item.Description))
                                            {
                                                <p class="text-muted small mb-0">@item.Description</p>
                                            }
                                        </div>
                                    </article>
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
        }
    }
</div>

<style>
    .menu-page .menu-item {
        border: 1px solid #e9ecef;
        border-radius: 0.75rem;
    }

    .menu-page .menu-item-image {
        height: 180px;
        object-fit: cover;
        border-top-left-radius: 0.75rem;
        border-top-right-radius: 0.75rem;
    }

    .menu-page .menu-price {
        font-size: 0.85rem;
        white-space: nowrap;
    }
</style>

