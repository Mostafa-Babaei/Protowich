	<script>
		(function () {
			const AUTH_CTX_KEY = "auth_context_v1";

			async function logout() {
				try {
					// ???????? API ???????
					await apiRequest('POST', '/api/auth/logout');

				} catch (err) {
					// ??? ??? ??? ????? ????? ???? ??????? ???
					console.warn("Logout API failed:", err);
				} finally {
					// ???????? ???? ?????
					sessionStorage.removeItem(AUTH_CTX_KEY);
					sessionStorage.removeItem("api_token");
					sessionStorage.removeItem("perm_map_v1");
					try {
						delete window.PERM;
					} catch (e) {
						window.PERM = null;
					}
					// ????????
					window.location.href = '/Login';
				}
			}

			document.addEventListener("DOMContentLoaded", function () {
				const btn = document.getElementById("btnLogout");
				if (!btn) return;

				btn.addEventListener("click", function (e) {
					e.preventDefault();
					logout();
				});
			});
		})();
	</script>

	<script>
		(function () {
			const CACHE_KEY = "auth_context_v1";
			const CACHE_PERM_KEY = "perm_map_v1";

			function getCached() {
				try {
					return JSON.parse(sessionStorage.getItem(CACHE_KEY) || "null");
				} catch {
					return null;
				}
			}

			function clearCached() {
				sessionStorage.removeItem(CACHE_KEY);
				sessionStorage.removeItem(CACHE_PERM_KEY);
				sessionStorage.removeItem("api_token"); // ??? ???? ?? ?? ????? ??? ???????

				// ??? PERM ?? ?????? ??? ?????
				try {
					delete window.PERM;
				} catch (e) {
					window.PERM = null;
				}
			}

			function normalizeUrl(item) {
				return item?.url || item?.route || item?.href || "#";
			}

			function getVal(obj, ...keys) {
				for (const k of keys) {
					if (obj && obj[k] !== undefined && obj[k] !== null) return obj[k];
				}
				return null;
			}

			function renderUser(ctx) {
				const name = ctx?.user?.displayName || ctx?.user?.username || "";
				const role = ctx?.primaryRoleTitle || "";

				const $name = $("#uiUserName");
				const $role = $("#uiRoleTitle");

				if ($name.length) $name.text(name);
				if ($role.length) $role.text(role);
			}

			// --- ???? ???? ?? ???? ParentId ---
			function buildTreeByParentId(menu) {
				// ??? ???? ??????? children ?? ????? ?????? ??? ?? ??? ???????
				const flat = [];
				(menu || []).forEach(m => {
					flat.push(m);
					const ch = getVal(m, "children", "Children");
					if (Array.isArray(ch) && ch.length) flat.push(...ch);
				});

				// ????? ?? ????? ? map ???????
				const map = new Map();
				flat.forEach(raw => {
					const id = getVal(raw, "id", "Id");
					if (id == null) return;

					// ??? ???? ? children ????
					const node = map.get(id) || {
						...raw
					};
					node.__id = id;
					node.__parentId = getVal(raw, "parentId", "ParentId");
					node.__order = getVal(raw, "displayOrder", "DisplayOrder") ?? 0;
					node.__title = getVal(raw, "title", "Title") ?? "";
					node.__icon = getVal(raw, "icon", "Icon") ?? "far fa-circle";
					node.__children = node.__children || [];
					map.set(id, node);
				});

				// ??? ???? ??????? ?? ????
				const roots = [];
				map.forEach(node => {
					const pid = node.__parentId;

					// ????: ParentId null/undefined/0/"0"
					const isRoot = pid == null || pid === 0 || pid === "0";
					if (isRoot) {
						roots.push(node);
					} else {
						const parent = map.get(pid);
						if (parent) parent.__children.push(node);
						else roots.push(node); // ??? ???? ???? ???? ???? ???? ?? ?? ???
					}
				});

				// ???? ???????
				function sortRec(list) {
					list.sort((a, b) => (a.__order ?? 0) - (b.__order ?? 0));
					list.forEach(n => sortRec(n.__children));
				}
				sortRec(roots);

				return roots;
			}

			// --- ???? ???? ---
			function renderMenuByParentId(menu) {
				const $ul = $("#sideMenu");
				if (!$ul.length) return;

				const roots = buildTreeByParentId(menu);
				$ul.empty();

				roots.forEach(item => {
					const title = item.__title;
					const icon = item.__icon;
					const children = item.__children;

					if (children && children.length) {
						const parentId = "m_" + item.__id; // ???? ? ???? ?????
						const $li = $(`
			<li class="nav-item has-treeview">
			  <a href="#" class="nav-link">
				<i class="nav-icon ${icon}"></i>
				<p>
				  ${title}
				  <i class="right fas fa-angle-left"></i>
				</p>
			  </a>
			  <ul class="nav nav-treeview" id="${parentId}"></ul>
			</li>
		  `);

						$ul.append($li);
						const $childUl = $("#" + parentId);

						children.forEach(ch => {
							const chTitle = ch.__title;
							const chIcon = ch.__icon || "far fa-circle";
							const chUrl = normalizeUrl(ch);

							// ??? ??? ???? ??????? ?????? ???????? recurse ????.
							const $chLi = $(`
			  <li class="nav-item">
				<a href="${chUrl}" class="nav-link">
				  <i class="${chIcon} nav-icon"></i>
				  <p>${chTitle}</p>
				</a>
			  </li>
			`);

							$childUl.append($chLi);
						});

					} else {
						const url = normalizeUrl(item);
						const $li = $(`
			<li class="nav-item">
			  <a href="${url}" class="nav-link">
				<i class="nav-icon ${icon}"></i>
				<p>${title}</p>
			  </a>
			</li>
		  `);
						$ul.append($li);
					}
				});
			}

			// ---- init ----
			const ctx = getCached();
			if (!ctx) {
                return;
            }

			renderUser(ctx);
			renderMenuByParentId(ctx.menu);

			// $(document).ajaxError(function (event, xhr) {
			// 	if (xhr && xhr.status === 401) {
			// 		clearCached();
			// 		window.location.href = "/Login";
			// 	}
			// });
		})();
	</script>

	<script>
