@{
    var userName = ViewBag.UserName as string ?? "";
    var roleTitle = ViewBag.RoleTitle as string ?? "";
    var ctrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLower();
    var area = (ViewContext.RouteData.Values["area"]?.ToString() ?? "").ToLower();

    bool IsAdminArea() => area == "admin";

    string NavActive(params string[] controllers)
        => IsAdminArea() && controllers.Any(c => c.ToLower() == ctrl) ? "active" : "";

    string MenuOpen(params string[] controllers)
        => IsAdminArea() && controllers.Any(c => c.ToLower() == ctrl) ? "menu-open" : "";

    string LinkActive(params string[] controllers)
        => NavActive(controllers);
}

<!DOCTYPE html>
<html lang="fa">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>پنل مدیریت</title>

    <link rel="stylesheet" href="~/assets/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/assets/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="~/assets/dist/css/rtl.css">
    <link rel="stylesheet" href="~/assets/css/customStyle.css">
    <link rel="stylesheet" href="~/assets/plugins/select2/css/select2.min.css">
    <link rel="stylesheet" href="~/assets/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css">
    <link rel="stylesheet" href="~/assets/dist/css/persian-datepicker.min.css">
    <link rel="stylesheet" href="~/assets/js/sweetalert.css">
    <link rel="stylesheet" href="~/css/toastr.min.css">
    <link rel="stylesheet" href="~/css/site.css">
    <link rel="stylesheet" href="~/css/flatpickr.min.css">

    <script src="~/assets/plugins/jquery/jquery.min.js"></script>

    <script>
        window.APP_CONFIG = {
            apiBaseUrl: '@(ViewBag.ApiBaseUrl ?? "")'
        };
    </script>
</head>

<body class="hold-transition sidebar-mini layout-fixed" dir="rtl">
    <div id="globalLoader" style="display:none">
        <div class="gl-backdrop"></div>
        <div class="gl-box">
            <div class="spinner-border" role="status" aria-hidden="true"></div>
            <div class="mt-2 small">در حال پردازش...</div>
        </div>
    </div>

    <div class="wrapper">

        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link">داشبورد</a>
                </li>
            </ul>

            <ul class="navbar-nav ml-auto">
                <li class="nav-item mr-3">
                    <span class="nav-link">
                        <i class="fas fa-user-circle"></i>
                        <span id="uiUserName">@userName</span>
                    </span>
                </li>

                <li class="nav-item mr-3">
                    <span class="nav-link">
                        <span class="badge badge-info p-2" id="uiRoleTitle">@roleTitle</span>
                    </span>
                </li>

                <li class="nav-item">
                    <form asp-area="" asp-controller="Login" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn nav-link text-danger border-0 bg-transparent">
                            <i class="fas fa-sign-out-alt"></i> خروج
                        </button>
                    </form>
                </li>
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="brand-link">
                <span class="brand-text font-weight-light">مدیریت</span>
            </a>

            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link @(IsAdminArea() && ctrl=="dashboard" ? "active" : "")">
                                <i class="nav-icon fas fa-home"></i>
                                <p>داشبورد</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="ManageMenu" asp-action="Index" class="nav-link @LinkActive("managemenu")">
                                <i class="nav-icon fas fa-layer-group"></i>
                                <p>مدیریت منو</p>
                            </a>
                        </li>

                        <!-- ✅ منوی جدید: مدیریت منو -->
                        <li class="nav-item has-treeview @MenuOpen("foodcategories","fooditems","foodimages")">
                            <a href="#" class="nav-link @(IsAdminArea() && new[]{"foodcategories","fooditems","foodimages"}.Contains(ctrl) ? "active" : "")">
                                <i class="nav-icon fas fa-utensils"></i>
                                <p>
                                    مدیریت منو
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>

                            <ul class="nav nav-treeview">

                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="FoodCategories" asp-action="Index"
                                       class="nav-link @LinkActive("foodcategories")">
                                        <i class="far fa-folder nav-icon"></i>
                                        <p>دسته‌بندی‌ها</p>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="FoodItems" asp-action="Index"
                                       class="nav-link @LinkActive("fooditems")">
                                        <i class="far fa-list-alt nav-icon"></i>
                                        <p>آیتم‌های منو</p>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="FoodItems" asp-action="Create"
                                       class="nav-link">
                                        <i class="far fa-plus-square nav-icon"></i>
                                        <p>افزودن آیتم جدید</p>
                                    </a>
                                </li>

                            </ul>
                        </li>


                        <li class="nav-item">
                            <a href="/user" class="nav-link">
                                <i class="nav-icon fas fa-user-cog"></i>
                                <p>مدیریت کاربران</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/Roles" class="nav-link">
                                <i class="nav-icon fas fa-user-shield"></i>
                                <p>مدیریت نقش ها</p>
                            </a>
                        </li>


                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content -->
        <div class="content-wrapper p-3">
            @RenderBody()
        </div>

        <footer class="main-footer text-center">
            <strong>© سیستم مدیریت پروتوویچ</strong>
        </footer>

    </div>

    <script src="~/js/toastr.min.js"></script>
    <script src="~/js/SweetAlert2.min.js"></script>
    <script src="~/js/toast.js"></script>

    <!-- ✅ jQuery دوباره لود نشود -->
    <script src="~/assets/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/dist/js/adminlte.min.js"></script>
    <script src="~/assets/plugins/select2/js/select2.full.min.js"></script>

    <script src="~/js/flatpickr.min.js"></script>
    <script src="~/js/flatpickr.fa.js"></script>

    <script src="~/assets/dist/js/persian-date.min.js"></script>
    <script src="~/assets/dist/js/persian-datepicker.min.js"></script>
    <script src="~/assets/js/sweetalert.min.js"></script>
    <script src="~/js/public/visitors/js/jalali.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
